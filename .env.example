APP_ENV=development
APP_NAME=研伴 RepoPilot
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Authentication is required even in DEMO_MODE. No default account/password.
# Session length in hours, capped at 2160 (90 days).
AUTH_SESSION_HOURS=12
# Automatically enabled when APP_ENV=production; use HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTRATION=false
# Required for first setup in production or from a non-loopback client.
# Set a random secret outside source control, then enter it on the setup page.
AUTH_BOOTSTRAP_TOKEN=

# Reverse proxy deployment only: which direct peers may rewrite the client IP
# from X-Forwarded-For. Empty = never trust the header; "loopback" = trust a
# local nginx etc.; or a comma separated list of proxy IPs/CIDRs.
# Required in production behind a proxy, otherwise the login IP throttle
# treats every user as the proxy address.
TRUSTED_PROXIES=

DATABASE_URL=postgresql+psycopg://devflow:devflow@localhost:5432/devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow
POSTGRES_DB=devflow

# Legacy configuration only; user requests never borrow a server-wide token.
# Supply each repository's token through the authenticated connection form.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# AI_API_KEY, AI_BASE_URL and AI_MODEL in the system environment take priority
# over the legacy LLM_* names. A bare API origin is normalized to /v1.
# Keep real AI credentials in the system environment, not this file.

# openai_compatible: call EMBEDDING_BASE_URL/embeddings.
# local: use sentence-transformers and LOCAL_EMBEDDING_MODEL.
# deterministic: local hash fallback for demos/tests only.
EMBEDDING_PROVIDER=qwen_local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_DEVICE=
LOCAL_EMBEDDING_REVISION=

MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=devflow_rag_qwen1024
RAG_RERANK_TOP_N=24
# Native Ragas evaluation. Judge settings fall back to the LLM_* values when blank.
RAGAS_ENABLED=true
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_BASE_URL=
RAGAS_JUDGE_MODEL=
RAGAS_TIMEOUT_SECONDS=120
RAGAS_JUDGE_MAX_TOKENS=8192
RAGAS_ANSWER_RELEVANCY_STRICTNESS=1
RAGAS_MAX_CASES=5
RAGAS_CONTEXT_PRECISION_MIN=0.75
RAGAS_CONTEXT_RECALL_MIN=0.80
RAGAS_FAITHFULNESS_MIN=0.90
RAGAS_ANSWER_RELEVANCY_MIN=0.80
RAGAS_AGENT_GOAL_ACCURACY_MIN=0.80
RAGAS_TOOL_CALL_ACCURACY_MIN=0.90
RAGAS_TOOL_CALL_F1_MIN=0.90
CONTEXT_MAX_INPUT_TOKENS=24000
CONTEXT_RESERVED_RESPONSE_TOKENS=3000
CONTEXT_DYNAMIC_MODEL_WINDOW_ENABLED=true
CONTEXT_MODEL_WINDOW_TOKENS=0
CONTEXT_COMPACT_RESERVED_OUTPUT_TOKENS=12000
CONTEXT_AUTO_COMPACT_ENABLED=true
CONTEXT_WARNING_BUFFER_TOKENS=20000
CONTEXT_AUTO_COMPACT_BUFFER_TOKENS=13000
CONTEXT_AGGRESSIVE_BUFFER_TOKENS=8000
CONTEXT_MANUAL_BUFFER_TOKENS=3000
CONTEXT_MAX_COMPACTION_FAILURES=3
CONTEXT_MICROCOMPACT_KEEP_RECENT_MESSAGES=8
CONTEXT_COMPACT_KEEP_RECENT_MESSAGES=8
CONTEXT_COMPACT_SUMMARY_TOKENS=1800
CONTEXT_SYSTEM_RATIO=0.12
CONTEXT_MEMORY_RATIO=0.22
CONTEXT_EVIDENCE_RATIO=0.34
CONTEXT_RECENT_RATIO=0.22
CONTEXT_TOOL_RATIO=0.10
# Planner: total model-call deadline; failure falls back to the rule planner.
PLANNER_TIMEOUT_SECONDS=30
PLANNER_MAX_TOKENS=2048
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_KEY=devflow-agent-v1
PROMPT_CACHE_RETENTION=
REPO_CHECKOUT_DIR=.data/repos
UPLOAD_DIR=.data/uploads

# Encrypts per-repository GitHub tokens at rest. The backend refuses to start
# in APP_ENV=production when this is left at the built-in default value.
TOKEN_ENCRYPTION_KEY=change-me-in-local-dev
DEMO_MODE=false
GITHUB_WEBHOOK_SECRET=

# Optional: send negative answer feedback to a Feishu custom-bot webhook.
FEISHU_FEEDBACK_WEBHOOK_URL=
# Public backend origin used to build the trace link in group notifications.
FEEDBACK_TRACE_BASE_URL=http://localhost:8000
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=300
AUTO_SYNC_LIMIT=50
# Scheduler syncs up to this many repositories in parallel per cycle.
AUTO_SYNC_CONCURRENCY=3
# Webhook-triggered syncs closer than this window are skipped (replay/storm guard).
WEBHOOK_SYNC_COOLDOWN_SECONDS=30
# Soft-deleted repositories stay restorable for this many hours before purge.
REPO_SOFT_DELETE_RETENTION_HOURS=168
# Per-user sliding-window limit per minute for LLM-costly endpoints
# (chat streams and RAGAS evals). 0 disables the limit.
LLM_REQUEST_RATE_LIMIT_PER_MINUTE=60
# Logging: LOG_LEVEL (DEBUG/INFO/WARNING/...), LOG_FORMAT (text/json).
# Every log line carries the request id also returned in the X-Request-ID header.
LOG_LEVEL=INFO
LOG_FORMAT=text
# PBKDF2 password-hash iterations. Lower to 2000 for the test suite only;
# keep the 600000 default in production.
PBKDF2_ITERATIONS=600000
# In-process TTL cache for RAG retrieval results; writes/deletes/reindex
# invalidate it automatically. 0 disables caching.
RAG_RETRIEVAL_CACHE_TTL_SECONDS=60
RAG_RETRIEVAL_CACHE_MAX_ENTRIES=256

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
